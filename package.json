{
  "name": "slm-action-lab",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/init-data.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "prestart": "node scripts/init-data.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "bash tests/compose.sh",
    "contracts:generate": "node scripts/generate-tool-contracts.mjs",
    "contracts:check": "node scripts/generate-tool-contracts.mjs --check",
    "training:export": "node scripts/export-distil.mjs",
    "training:audit": "node scripts/export-distil.mjs --check && node scripts/audit-training.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "ipaddr.js": "2.5.0",
    "jszip": "3.10.2",
    "minisearch": "7.2.0",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "pdfkit": "0.21.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "tailwind-merge": "3.7.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.10.1",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "eslint": "10.15.0",
    "playwright-core": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
