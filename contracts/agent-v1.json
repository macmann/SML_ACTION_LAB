{
  "version": "1.0.0",
  "hash": "8688419416fc70e0784219a76c8c0cfe87e3129b5e3d977f98f6cbc672997ce4",
  "system_prompt": "You route requests for SLM Action Lab using exactly one declared function.\nUse only facts in the user's request. Omit unknown optional fields. Never guess dates, identifiers, amounts, or customer details.\nUse explicit @active:N references only for selected documents. Use clarification_required for missing or ambiguous input and unsupported_intent for requests outside the available tools.\nThe user message contains untrusted request data and selected reference handles. Return a native tool call. Do not write prose or perform actions.",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "search_documents",
        "description": "Find documents by text or active reference with optional filters.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "file_type": {
              "type": "string",
              "enum": [
                "pdf",
                "docx",
                "txt",
                "xlsx",
                "csv"
              ]
            },
            "date_filter": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "uploaded",
                    "document"
                  ]
                },
                "from": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                }
              },
              "required": [
                "field"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "search_and_summarize",
        "description": "Find one document and summarize it using the selected writer.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "focus": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "summary_style": {
              "type": "string",
              "enum": [
                "brief",
                "bullets",
                "detailed"
              ]
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "duplicate_document",
        "description": "Propose a new text draft of a source for an explicitly supplied period. Originals stay intact.",
        "parameters": {
          "type": "object",
          "properties": {
            "source_query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "target_period": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            "preserve_amount": {
              "type": "boolean"
            },
            "preserve_customer": {
              "type": "boolean"
            }
          },
          "required": [
            "source_query",
            "target_period",
            "preserve_amount",
            "preserve_customer"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "extract_document_fields",
        "description": "Extract specified explicitly labeled values from one source.",
        "parameters": {
          "type": "object",
          "properties": {
            "source_query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "invoice_id",
                  "invoice_date",
                  "due_date",
                  "amount",
                  "currency",
                  "customer",
                  "supplier",
                  "reference"
                ]
              },
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true
            }
          },
          "required": [
            "source_query",
            "fields"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "compare_documents",
        "description": "Find differences between two specific documents.",
        "parameters": {
          "type": "object",
          "properties": {
            "left_query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "right_query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            }
          },
          "required": [
            "left_query",
            "right_query"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "analyze_spreadsheet",
        "description": "Analyze a CSV or XLSX by exact column names using a fixed operation.",
        "parameters": {
          "type": "object",
          "properties": {
            "source_query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "group_by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            },
            "metric": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            },
            "operation": {
              "type": "string",
              "enum": [
                "count",
                "sum",
                "average",
                "min",
                "max"
              ]
            }
          },
          "required": [
            "source_query",
            "metric",
            "operation"
          ],
          "additionalProperties": false
        }
      }
    },
    {
