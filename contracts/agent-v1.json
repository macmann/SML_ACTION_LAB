    {
      "type": "function",
      "function": {
        "name": "modify_and_convert",
        "description": "Propose a new TXT or PDF from exact literal replacements in one extracted source.",
        "parameters": {
          "type": "object",
          "properties": {
            "source_query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "replacements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "find": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "\\S"
                  },
                  "replace": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [
                  "find",
                  "replace"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 12,
              "uniqueItems": true
            },
            "output_format": {
              "type": "string",
              "enum": [
                "txt",
                "pdf"
              ]
            }
          },
          "required": [
            "source_query",
            "replacements",
            "output_format"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
