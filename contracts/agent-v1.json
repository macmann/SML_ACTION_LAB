    },
    {
      "type": "function",
      "function": {
        "name": "draft_email",
        "description": "Draft email text from one source with the selected writer. Never sends mail.",
        "parameters": {
          "type": "object",
          "properties": {
            "source_query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
